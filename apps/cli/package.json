{
  "name": "@macklinu/config",
  "private": true,
  "version": "0.0.0",
  "description": "Set up my project configurations",
  "type": "module",
  "bin": {
    "config": "./dist/index.js"
  },
  "scripts": {
    "build": "pnpm clean && tsc -p tsconfig.build.json",
    "clean": "node --eval \"import { rmSync } from 'node:fs'; rmSync('dist', { force: true, recursive: true })\"",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.build.json --noEmit"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.0-rc.112",
    "effect": "4.0.0-rc.112"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "typescript": "^7.0.2",
    "vitest": "^4.0.15"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
