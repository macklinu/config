{
  "name": "@macklinu/oxlint-config",
  "version": "2.1.1",
  "description": "My personal Oxlint configuration",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/macklinu/config.git",
    "directory": "packages/oxlint"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./base": {
      "types": "./dist/base.d.ts",
      "import": "./dist/base.js"
    },
    "./effect": {
      "types": "./dist/effect.d.ts",
      "import": "./dist/effect.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./type-aware": {
      "types": "./dist/type-aware.d.ts",
      "import": "./dist/type-aware.js"
    },
    "./vitest": {
      "types": "./dist/vitest.d.ts",
      "import": "./dist/vitest.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "oxlint"
  ],
  "author": "Mackie Underdown <macklinu@users.noreply.github.com>",
  "license": "MIT",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm run build",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@effect/tsgo": ">=0.53.1",
    "effect": ">=4.0.0-0 <5.0.0",
    "oxlint": ">=1.86.0",
    "oxlint-tsgolint": ">=7.0.2003",
    "typescript": ">=7.0.0"
  },
  "peerDependenciesMeta": {
    "@effect/tsgo": {
      "optional": true
    },
    "effect": {
      "optional": true
    },
    "oxlint-tsgolint": {
      "optional": true
    }
  },
  "devDependencies": {
    "@effect/tsgo": "0.53.1",
    "effect": "4.0.0-rc.118",
    "oxlint": "1.86.0",
    "oxlint-tsgolint": "7.0.2003",
    "typescript": "7.0.2"
  }
}
