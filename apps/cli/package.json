{
  "name": "@macklinu/config",
  "private": true,
  "version": "0.0.0",
  "description": "Set up my project configurations",
  "type": "module",
  "bin": {
    "config": "./dist/index.js"
  },
  "scripts": {
    "build": "tsdown src/index.ts --clean --target node22 --no-fixed-extension --tsconfig tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.0-rc.112",
    "effect": "4.0.0-rc.112"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "tsdown": "0.22.14",
    "typescript": "^7.0.2",
    "vitest": "^4.0.15"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
